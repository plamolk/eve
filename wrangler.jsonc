{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eve-survey",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // หน้าเว็บเป็น static assets (ฟรี ไม่จำกัด) — Worker ทำงานเฉพาะ /api/*
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "build": { "command": "npm run build:css" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eve-survey",
      // แทนด้วยค่าจาก `npx wrangler d1 create eve-survey` ตอน deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "SHEETS_URL": "REPLACE_WITH_APPS_SCRIPT_URL",
    "QUOTA_RATIO": "0.8",
    "D1_WRITE_LIMIT": "100000",
    "D1_READ_LIMIT": "5000000",
    // hostname ของ Turnstile ที่ยอมรับ (คั่นด้วย ,) เช่น eve-survey.<account>.workers.dev
    "ALLOWED_HOSTS": "REPLACE_WITH_HOSTNAME",
    "TURNSTILE_STRICT": "1"
  }
  // secrets (wrangler secret put): TURNSTILE_SECRET, ADMIN_PASSWORD, SESSION_KEY, SHEETS_TOKEN, IMPORT_TOKEN
}
